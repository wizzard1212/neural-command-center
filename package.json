{
  "name": "neural-command-center",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"pnpm --filter @ncc/server dev\" \"pnpm --filter @ncc/web dev\"",
    "build": "pnpm --filter @ncc/shared build && pnpm --filter @ncc/server build && pnpm --filter @ncc/web build",
    "test": "pnpm --filter @ncc/server test && pnpm --filter @ncc/web test",
    "db:generate": "pnpm --filter @ncc/server db:generate",
    "db:migrate": "pnpm --filter @ncc/server db:migrate"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
